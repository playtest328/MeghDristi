# Copy to .env and fill in what you have. The pipeline runs entirely on
# synthetic/mock data — there is no live external data source configured.
# See README.md and WRITEUP.md for details.

# Twilio SMS hazard alerts (optional).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBERS=
ALERT_MIN_SEVERITY=high
ALERT_COOLDOWN_MINUTES=60
